# Non-secret paths only. Configure the file contents using environment secrets.
# Private key file: ASCII-armored GPG secret-key export.
export DROPMUX_SIGNING_KEY_FILE=/run/secrets/dropmux-signing-key.asc
# Optional: omit this line if the key has no passphrase.
export DROPMUX_SIGNING_PASSPHRASE_FILE=/run/secrets/dropmux-signing-passphrase
# Expected existing repository signing key; do not substitute another key.
export DROPMUX_SIGNING_FINGERPRINT=865598DF7228194559CCDBE0A145D35EABFD8722
